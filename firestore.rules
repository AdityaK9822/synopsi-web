rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users/{uid}: only its owner can read; only the Admin SDK (server) writes.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }
    // usage/{uid}: one doc per user whose map keys are UTC-period ids →
    // opaque counters, only the Admin SDK may touch them.
    match /usage/{uid} {
      allow read, write: if false;
    }
    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
