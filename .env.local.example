# Copy this file to `.env.local` and fill in your key.
# Create a free API key at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Model called through the Ollama API. NOTE: via the API the "-cloud"
# suffix is omitted (that tag form is only for the CLI / Ollama app).
OLLAMA_MODEL=gemma4:31b

# ── Firebase (public client config — safe to commit/deploy as build env) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Server-side admin credential (SECRET — paste the downloaded
#    service-account JSON as ONE line; never commit this) ──
# Firebase console → project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT=
